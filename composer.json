{
  "name": "joomengine/mcp-component",
  "description": "Database-driven Joomla MCP server component and shared local console runtime",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-json": "*",
    "mcp/sdk": "~0.8.1",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "opis/json-schema": "^2.4",
    "php-http/curl-client": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "VDM\\Component\\JoomEngineMcp\\Administrator\\": "admin/src/",
      "VDM\\Component\\JoomEngineMcp\\Api\\": "api/src/",
      "VDM\\Component\\JoomEngineMcp\\Site\\": "site/src/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    },
    "sort-packages": true
  }
}

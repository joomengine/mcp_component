<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
  <name>COM_JOOMENGINE_MCP</name>
  <element>com_joomengine_mcp</element>
  <author>Llewellyn van der Merwe</author>
  <authorEmail>joomla@vdm.io</authorEmail>
  <authorUrl>https://dev.vdm.io/</authorUrl>
  <creationDate>September 2026</creationDate>
  <copyright>Copyright (C) 2026 Vast Development Method. All rights reserved.</copyright>
  <license>GNU General Public License version 3 or later; see LICENSE</license>
  <version>0.1.1</version>
  <description>COM_JOOMENGINE_MCP_XML_DESCRIPTION</description>
  <namespace path="src">VDM\Component\JoomEngineMcp</namespace>
  <scriptfile>Joomengine_mcpInstallerScript.php</scriptfile>
  <files folder="site"><folder>src</folder></files>
  <api><files folder="api"><folder>src</folder></files></api>
  <media destination="com_joomengine_mcp" folder="media">
    <filename>joomla.asset.json</filename><folder>js</folder>
  </media>
  <administration>
    <menu view="providers">COM_JOOMENGINE_MCP</menu>
    <submenu>
      <menu view="providers">COM_JOOMENGINE_MCP_PROVIDERS</menu>
      <menu view="schemas">COM_JOOMENGINE_MCP_SCHEMAS</menu>
      <menu view="actions">COM_JOOMENGINE_MCP_ACTIONS</menu>
      <menu view="bindings">COM_JOOMENGINE_MCP_BINDINGS</menu>
      <menu view="tools">COM_JOOMENGINE_MCP_TOOLS</menu>
      <menu view="resources">COM_JOOMENGINE_MCP_RESOURCES</menu>
      <menu view="prompts">COM_JOOMENGINE_MCP_PROMPTS</menu>
      <menu view="targets">COM_JOOMENGINE_MCP_TARGETS</menu>
      <menu view="operations">COM_JOOMENGINE_MCP_OPERATIONS</menu>
    </submenu>
    <files folder="admin">
      <folder>src</folder><folder>services</folder><folder>forms</folder><folder>tmpl</folder>
      <folder>layouts</folder><folder>sql</folder><folder>language</folder><folder>cli</folder>
      <folder>vendor</folder><folder>data</folder><filename>access.xml</filename><filename>config.xml</filename>
      <filename>LICENSE</filename>
    </files>
    <languages folder="admin/language">
      <language tag="en-GB">en-GB/com_joomengine_mcp.ini</language>
      <language tag="en-GB">en-GB/com_joomengine_mcp.sys.ini</language>
    </languages>
  </administration>
  <install><sql>
    <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
    <file driver="postgresql" charset="utf8">sql/install.postgresql.utf8.sql</file>
  </sql></install>
  <uninstall><sql>
    <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
    <file driver="postgresql" charset="utf8">sql/uninstall.postgresql.utf8.sql</file>
  </sql></uninstall>
  <update><schemas schemapath="sql/updates" /></update>
  <updateservers>
    <server type="extension" priority="1" name="JoomEngine MCP updates">https://github.com/joomengine/mcp_component/releases/latest/download/joomengine_mcp_update_server.xml</server>
  </updateservers>
  <changelogurl>https://raw.githubusercontent.com/joomengine/mcp_component/main/changelog.xml</changelogurl>
</extension>
